# Порт веб-сервера
PORT=3000

# Провайдер с протоколом OpenAI — включает персонализацию текстов результата и роадмапа.
# Без ключа сервис работает на шаблонных текстах.
OPENAI_API_KEY=
# Базовый адрес, если провайдер не официальный OpenAI (OpenRouter, Groq, vLLM, Ollama).
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Модель (по умолчанию gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Пароль для /admin (логин любой). Без пароля админка выключена.
ADMIN_PASSWORD=

# Ссылки
PRIVACY_POLICY_URL=https://cityuniversity.ru/policy
CONSULTATION_URL=https://cityuniversity.ru/school-urban-producers
SCHOOL_URL=https://cityuniversity.ru/school-urban-producers

# Папка для хранения заявок (JSON-файл)
# DATA_DIR=./data
