{
  "name": "cu-diagnostic",
  "version": "0.1.0",
  "description": "Диагностика городского проекта — лид-магнит Школы городских продюсеров (Городской университет 2.0)",
  "type": "module",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@netlify/blobs": "^11.1.3",
    "hono": "^4.13.12",
    "openai": "^7.30.0"
  }
}
